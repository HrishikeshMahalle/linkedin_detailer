# Never put real values in this file.
APP_ENV=development
PORT=8080
APP_API_KEY=replace-with-a-long-random-value

# Override only when LinkedIn changes the current Dash response decoration.
LINKEDIN_DECORATION_ID=com.linkedin.voyager.dash.deco.identity.profile.FullProfileWithEntities-93

CACHE_TTL=30m
CACHE_MAX_ENTRIES=200
MAX_CONCURRENT_SCRAPES=2
RATE_LIMIT_RPM=10
RATE_LIMIT_BURST=3
LINKEDIN_REQUEST_INTERVAL=2s
REQUEST_TIMEOUT=25s
UPSTREAM_TIMEOUT=15s
LINKEDIN_COOLDOWN=15m
